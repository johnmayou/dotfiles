{
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "explorer.confirmDelete": false,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "editor.minimap.enabled": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.verticalScrollbarSize": 0,
  "editor.scrollbar.horizontalScrollbarSize": 0,
  "redhat.telemetry.enabled": true,
  "editor.stickyScroll.enabled": false,
  "go.toolsManagement.autoUpdate": true,
  "C_Cpp.clang_format_fallbackStyle": "Google",
  "C_Cpp.clang_format_style": "Google",
  "C_Cpp.default.compilerPath": "/usr/bin/clang++",
  "editor.parameterHints.enabled": false,
  "[cpp]": {
    "editor.wordBasedSuggestions": "off",
    "editor.semanticHighlighting.enabled": true,
    "editor.stickyScroll.defaultModel": "foldingProviderModel",
    "editor.suggest.insertMode": "replace",
  },
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.compilerArgs": ["-std=c++20"],
  "editor.fontSize": 14,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "java.format.settings.url": "",
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
  },
  "java.inlayHints.parameterNames.enabled": "none",
  "dotnet.codeLens.enableReferencesCodeLens": false,
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
  },
  "[go]": {
    // "editor.insertSpaces": true,
    // "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go",
  },
  "gitlens.graph.layout": "editor",
  "gitlens.codeLens.authors.enabled": false,
  "gitlens.codeLens.recentChange.enabled": false,
  "docker.extension.enableComposeLanguageServer": false,
  "find-it-faster.general.useTerminalInEditor": true,
  "python.analysis.typeCheckingMode": "standard",
  "zig.zls.enabled": "on",
  "makefile.configureOnOpen": true,
  "gitlens.ai.model": "gitkraken",
  "gitlens.ai.gitkraken.model": "gemini:gemini-2.0-flash",
  "editor.inlayHints.enabled": "off",
  "zig.zls.enableArgumentPlaceholders": false,
  "workbench.activityBar.location": "bottom",
  "claudeCode.preferredLocation": "panel",
  "git.openRepositoryInParentFolders": "always",
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
    "azure-pipelines.yml",
    "azure-pipelines.yaml",
  ],
  "workbench.colorTheme": "Dark Modern",
  "workbench.editor.empty.hint": "hidden",
  "explorer.confirmDragAndDrop": false,
  "files.exclude": {
    "**/__init__.py": true,
    "**/__pycache__": true,
  },
  "editor.renderWhitespace": "all",
  "editor.tabSize": 4,
  "editor.autoIndent": "full",
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "docker-desktop",
  ],
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "gitlens.codeLens.authors.command": false,
  "gitlens.rebaseEditor.openOnPausedRebase": false,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "chat.viewSessions.orientation": "stacked",
  "claudeCode.hideOnboarding": true,
  "zig.path": "zig",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": ["./src"],
  "mypy.configFile": "pyproject.toml",
  "databricks.logs.maxArrayLength": 1000,
  "databricks.logs.maxFieldLength": 1000,
  "databricks.logs.truncationDepth": 1000,
  "databricks.bundle.remoteStateRefreshInterval": 1,
  "aws.cloudformation.telemetry.enabled": false,
  "aws.cloudformation.diagnostics.cfnGuard.enabled": false,
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
    "editor.autoIndent": "full",
  },
  "yaml.format.enable": true,
  "yaml.validate": false,
  // CloudFormation intrinsic functions.
  "yaml.customTags": [
    "!And sequence",
    "!Base64",
    "!Base64 mapping",
    "!Cidr",
    "!Cidr sequence",
    "!Condition scalar",
    "!Equals sequence",
    "!FindInMap sequence",
    "!GetAtt",
    "!GetAtt sequence",
    "!GetAZs",
    "!If sequence",
    "!ImportValue",
    "!ImportValue mapping",
    "!Join sequence",
    "!Not sequence",
    "!Or sequence",
    "!Ref",
    "!Select sequence",
    "!Split sequence",
    "!Sub",
    "!Sub sequence",
    "!Transform mapping",
  ],
  "json.schemas": [
    {
      "fileMatch": ["*-template.json"],
      "url": "https://s3.amazonaws.com/cfn-resource-specifications-us-east-1-prod/schemas/2.15.0/all-spec.json",
    },
  ],
  "@azure.argTenant": "",
}
